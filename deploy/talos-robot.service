# Start the ROS robot node on boot. It is the only program that opens the
# servo port; the web UI (talos-web.service) and `talos-servo ... --ros` all go
# through it. Edit User, paths and the serial port, then:
#   sudo cp deploy/talos-robot.service deploy/talos-web.service \
#     /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now talos-robot talos-web
#   journalctl -u talos-robot -u talos-web -f
# Stop any hand-started `talos-servo` command on the port first; the second
# program to open the port fails with "already in use".

[Unit]
Description=Talos ROS robot node (owns the servo port)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/talos_hack
Environment=TALOS_SERVO_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B7B014358-if00
# The robot node, the web UI and every shell running --ros commands must use
# the same domain.
# Environment=ROS_DOMAIN_ID=0
ExecStart=/home/pi/.pixi/bin/pixi run -e ros robot-node
# SIGINT runs the node's Ctrl+C path: stop every speed joint, close the port.
KillSignal=SIGINT
TimeoutStopSec=10
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
