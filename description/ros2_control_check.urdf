<?xml version="1.0"?>
<!--
  Bench check for #88: one wheel through ros2_control. Not the robot model
  (#64). See docs/ros2_control.md.
-->
<robot name="talos_ros2_control_check">
  <link name="base_link"/>
  <link name="front_left_wheel_link"/>

  <!-- Same name as the joint in config/robot.yaml: the bridge matches by
       name. -->
  <joint name="front_left_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <ros2_control name="talos_servo_bus" type="system">
    <hardware>
      <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
      <!-- Must match COMMANDS_TOPIC and STATES_TOPIC in
           hardware_bridge_node.py. -->
      <param name="joint_commands_topic">/talos/joint_commands</param>
      <param name="joint_states_topic">/talos/joint_states</param>
      <!-- Always send: the plugin otherwise skips a command when the summed
           position error is tiny, which drops velocity commands to a wheel
           resting near 0 rad. The bridge watchdog needs the stream too. -->
      <param name="trigger_joint_command_threshold">-1</param>
    </hardware>
    <joint name="front_left_wheel">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
</robot>
